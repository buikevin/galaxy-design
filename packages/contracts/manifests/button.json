  "props": [
    {
      "name": "variant",
      "type": {
        "kind": "union",
        "values": [
          "default",
          "destructive",
          "outline",
          "secondary",
          "ghost",
          "link"
        ]
      },
      "default": "default",
      "description": "Visual style variant.",
      "frameworks": ["react", "vue", "angular", "react-native", "flutter"],
      "overrides": {
        "flutter": {
          "type": {
            "kind": "union",
            "values": [
              "primary",
              "destructive",
              "outline",
              "secondary",
              "ghost",
              "link"
            ]
          }
        }
      }
    },
    {
      "name": "size",
      "type": {
        "kind": "union",
        "values": ["default", "sm", "lg", "icon"]
      },
      "default": "default",
      "description": "Size variant.",
      "frameworks": ["react", "vue", "angular", "react-native", "flutter"],
      "overrides": {
        "flutter": {
          "type": {
            "kind": "union",
            "values": ["defaultSize", "sm", "lg", "icon"]
          }
        }
      }
    },
    {
