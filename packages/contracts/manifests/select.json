    "keyboard": [
      "React/Vue use Radix listbox keyboard behavior.",
      "Angular implements combobox roles with basic keyboard handling."
    ],
    "aria": [
      "Trigger exposes combobox role with aria-expanded/aria-disabled on Angular.",
      "Content uses listbox role on Angular."
    ]
  },
  "notes": [
    "Flutter select renders a Material DropdownButton wrapper rather than a Radix-style listbox.",
    "P1.2 fix: Angular select now has full listbox keyboard behavior — roving active item with Arrow/Home/End, typeahead, Enter/Space selection, disabled-item skipping, aria-activedescendant/aria-controls wiring, and the selected checkmark bug (isSelected was never set) is fixed."
  ]
