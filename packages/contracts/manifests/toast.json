      "exports": ["Toaster", "toast"],
      "dependencies": ["sonner"],
      "notes": "Sonner-backed wrapper; `Toaster` renders and `toast()` triggers. Subpart anatomy (Title/Description/Viewport) is delegated to Sonner.",
      "props": [
        {
          "name": "theme",
          "type": {
            "kind": "union",
            "values": [
              {
                "kind": "literal",
                "value": "light"
              },
              {
                "kind": "literal",
                "value": "dark"
              },
              {
                "kind": "literal",
                "value": "system"
              }
            ]
          },
          "default": "light",
          "description": "Visual theme for the toaster."
        },
        {
          "name": "position",
          "type": {
            "kind": "union",
            "values": [
              {
                "kind": "literal",
                "value": "top-left"
