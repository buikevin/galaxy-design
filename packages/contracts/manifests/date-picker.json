    {
      "name": "maxDate",
      "type": {
        "kind": "custom",
        "name": "Date"
      },
      "description": "Maximum selectable date.",
      "frameworks": ["react-native", "flutter"]
    },
    {
      "name": "align",
      "type": {
        "kind": "union",
        "values": ["start", "center", "end"]
      },
      "default": "start",
      "description": "Popover alignment.",
      "frameworks": ["react"]
    },
    {
      "name": "mode",
      "type": {
        "kind": "union",
        "values": ["single", "range"]
      },
      "default": "single",
      "description": "Selection mode.",
      "frameworks": ["react-native"]
    }
  ],
