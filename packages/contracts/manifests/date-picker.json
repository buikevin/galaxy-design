{
  "$schema": "../schemas/component-manifest.schema.json",
  "id": "date-picker",
  "name": "Date Picker",
  "category": "form",
  "status": "partial",
  "description": "A date picker component with popover and calendar.",
  "props": [
    {
      "name": "value",
      "type": {
        "kind": "custom",
        "name": "Date"
      },
      "description": "Selected date.",
      "frameworks": ["react", "react-native", "flutter"],
      "overrides": {
        "react": {
          "name": "date"
        },
        "react-native": {
          "name": "selected"
        },
        "flutter": {
          "name": "selected"
        }
      }
    },
    {
      "name": "dateChange",
      "type": {
        "kind": "function",
        "signature": "(date: Date | undefined) => void"
      },
      "description": "Called when the selected date changes.",
      "frameworks": ["react", "react-native", "flutter"],
      "overrides": {
        "react": {
          "name": "onDateChange"
        },
        "react-native": {
          "name": "onChanged"
        },
        "flutter": {
          "name": "onChanged"
        }
      }
    },
    {
      "name": "placeholder",
      "type": {
        "kind": "primitive",
        "name": "string"
      },
      "default": "Pick a date",
      "description": "Placeholder text.",
      "frameworks": ["react", "react-native", "flutter"]
    },
    {
      "name": "format",
      "type": {
        "kind": "primitive",
        "name": "string"
      },
      "description": "Date format string.",
      "frameworks": ["react", "react-native", "flutter"],
      "overrides": {
        "react": {
          "name": "dateFormat"
        }
      }
